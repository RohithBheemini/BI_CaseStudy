table Zomato_PowerBI_Predictions
	lineageTag: 8796f8b1-db64-403e-927e-6e3c65703e2d

	measure 'Total Orders' =
			
			COUNTROWS('Zomato_PowerBI_Predictions')
		formatString: 0
		lineageTag: 9e0f784b-2349-4dd8-a7a8-6c397bb2948e

	measure 'Avg Actual Delivery' =
			
			AVERAGE('Zomato_PowerBI_Predictions'[Actual Delivery(min)])
		lineageTag: 4da4961b-db05-4a1d-9471-9357a84083f4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Predicted Delivery' =
			
			AVERAGE('Zomato_PowerBI_Predictions'[Predicted Delivery(min)])
		lineageTag: ecf6748c-c4bb-4ca5-aff4-deb7b8245cee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Error' =
			
			AVERAGE('Zomato_PowerBI_Predictions'[Error])
		lineageTag: 328aaa54-08b9-43cd-9a4c-97e0415d39b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Risk Orders' =
			
			CALCULATE(
			    [Total Orders],
			    'Zomato_PowerBI_Predictions'[Delay_Risk] = "High"
			)
		formatString: 0
		lineageTag: cc1f52c4-0565-46ab-9834-880dd3e9a0e2

	measure 'High Risk %' =
			
			DIVIDE(
			    [High Risk Orders],
			    [Total Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 96d8a98e-6be6-4349-b670-ad6739efc207

	measure 'SLA Compliant Orders' =
			
			CALCULATE(
			    [Total Orders],
			    'Zomato_PowerBI_Predictions'[Actual Delivery(min)] <= 30
			)
		formatString: #,0
		lineageTag: a1f2c3d4-1111-4a2b-8c3d-000000000001

	measure 'SLA Compliance %' =
			
			DIVIDE(
			    [SLA Compliant Orders],
			    [Total Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a1f2c3d4-1111-4a2b-8c3d-000000000002

	measure 'Avg Pickup Delay' =
			
			AVERAGE('Zomato_PowerBI_Predictions'[Pickup Delay(min)])
		formatString: 0.0
		lineageTag: a1f2c3d4-1111-4a2b-8c3d-000000000003

	measure 'Avg Transit Time' =
			
			AVERAGE('Zomato_PowerBI_Predictions'[Actual Delivery(min)]) - AVERAGE('Zomato_PowerBI_Predictions'[Pickup Delay(min)])
		formatString: 0.0
		lineageTag: a1f2c3d4-1111-4a2b-8c3d-000000000004

	measure 'Avg Distance km' =
			
			AVERAGE('Zomato_PowerBI_Predictions'[Distance km])
		formatString: 0.00
		lineageTag: a1f2c3d4-1111-4a2b-8c3d-000000000005

	measure 'Avg Rider Rating' =
			
			AVERAGE('Zomato_PowerBI_Predictions'[Delivery_person_Ratings])
		formatString: 0.00
		lineageTag: a1f2c3d4-1111-4a2b-8c3d-000000000006

	measure 'Avg Absolute Error' =
			
			AVERAGE('Zomato_PowerBI_Predictions'[Absolute Error(min)])
		formatString: 0.00
		lineageTag: a1f2c3d4-1111-4a2b-8c3d-000000000007

	measure 'Active Riders' =
			
			DISTINCTCOUNT('Zomato_PowerBI_Predictions'[Delivery_person_ID])
		formatString: #,0
		lineageTag: a1f2c3d4-1111-4a2b-8c3d-000000000008

